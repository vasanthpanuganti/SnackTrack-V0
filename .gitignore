# Dependencies
node_modules/
.pnpm-store/

# Build outputs
dist/
build/
.next/
*.tsbuildinfo

# Turborepo
.turbo/

# Environment — never commit secrets.
# All .env variants are ignored; only the documented example is tracked.
.env
.env.*
!.env.example

# Keys & certificates
*.pem
*.key
*.p12
*.pfx

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
*.egg-info/
.mypy_cache/
.pytest_cache/

# Testing
coverage/
.nyc_output/

# Logs
*.log
logs/

# Prisma
prisma/*.db

# Sentry
.sentryclirc

# ML notebooks — large data & trained weights
apps/ml-service/notebooks/data/*.parquet
apps/ml-service/notebooks/data/*.csv
apps/ml-service/notebooks/weights/*.npz

# Expo (future)
.expo/
